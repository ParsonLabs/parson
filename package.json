{
  "name": "parson-music",
  "version": "1.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "notices:generate": "node tools/generate-third-party-notices.cjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "release": "node tools/release.cjs",
    "version:sync": "node tools/release.cjs --sync",
    "version:check": "node tools/release.cjs --check",
    "audit:dependencies": "node tools/audit-dependencies.cjs"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "expo-constants": "57.0.21",
    "fast-uri": "3.1.8",
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "decode-uri-component": "0.5.0",
    "image-size": "2.0.3",
    "@node-minify/core>glob": "10.5.0"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "react-native-audio-api@0.13.6": "patches/react-native-audio-api@0.13.6.patch",
    "node-forge@1.4.0": "patches/node-forge@1.4.0.patch",
    "sprintf-js@1.1.3": "patches/sprintf-js@1.1.3.patch",
    "query-string@7.1.3": "patches/query-string@7.1.3.patch"
  }
}
