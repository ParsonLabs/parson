    "@radix-ui/react-slider": "1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tanstack/react-query": "5.104.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
